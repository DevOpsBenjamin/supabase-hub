# Shared Supabase project backing every app under apps/.
# Copy to .env and fill in, or export these before running scripts/.

# Project ref from the dashboard URL: https://supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=

# Read by the CLI for `supabase link` and `supabase db push`.
SUPABASE_DB_PASSWORD=

# Personal access token, so scripts run non-interactively.
SUPABASE_ACCESS_TOKEN=
